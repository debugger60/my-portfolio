# ============================================================
#  PORTFOLIO BACKEND — ENVIRONMENT CONFIGURATION
# ============================================================
#  Copy this file to `.env` and fill in real values.
#
#  The API works WITHOUT SMTP: messages are always logged to the
#  server console and counted. To EMAIL yourself the messages,
#  fill in the SMTP block below.

# --- server ---
PORT=4000

# --- cors: allowed origins (comma-separated) ---
#    e.g. http://localhost:3000, https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- where contact messages are emailed to ---
CONTACT_TO=pandakishoreranjan@gmail.com

# --- SMTP transport (e.g. Gmail app password, Zoho, Brevo) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Portfolio OS <you@gmail.com>"

# --- rate limiting (per IP, in-memory) ---
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# --- GitHub public-profile proxy ---
GITHUB_USERNAME=debugger60
